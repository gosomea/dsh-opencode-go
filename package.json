{
  "name": "@foreveryu/dsh-opencode-go",
  "version": "0.1.0",
  "description": "OpenCode Go and Zen live model discovery, session routing, pricing and eligibility diagnostics for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "scripts/migrate.mjs",
    "skills",
    "NOTICE",
    "docs/*.md",
    "docs/live-probe.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-models",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "tsc --emitDeclarationOnly && tsdown",
    "test": "vitest run",
    "pack:check": "node scripts/check-package.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/schemastery": "3.18.4",
    "@deepseek-ai/dsh-llm": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-credentials": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-settings": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-launch-environment": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-ui-settings-models": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-locale": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-home-paths": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-util-values": "0.1.7-alpha.2",
    "@deepseek-ai/cordis-plugin-loader": "1.0.5",
    "@deepseek-ai/dsh-fs": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-attachment": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.7-alpha.2"
  },
  "dependencies": {
    "js-yaml": "^4.2.0",
    "@earendil-works/pi-ai": "^0.85.1"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "0.22.2",
    "typescript": "6.0.3",
    "vitest": "4.1.8",
    "@deepseek-ai/cordis-plugin-include": "*"
  },
  "packageManager": "pnpm@11.7.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gosomea/dsh-opencode-go.git"
  },
  "homepage": "https://github.com/gosomea/dsh-opencode-go#readme",
  "bugs": {
    "url": "https://github.com/gosomea/dsh-opencode-go/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "opencode",
    "opencode-go",
    "opencode-zen",
    "model-discovery",
    "pricing"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
